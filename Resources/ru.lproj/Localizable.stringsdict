<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Payday in %lld days, %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Зарплата через %#@days@, %@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld день</string>
            <key>few</key><string>%lld дня</string>
            <key>many</key><string>%lld дней</string>
            <key>other</key><string>%lld дня</string>
        </dict>
    </dict>
    <key>in %lld days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>через %#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld день</string>
            <key>few</key><string>%lld дня</string>
            <key>many</key><string>%lld дней</string>
            <key>other</key><string>%lld дня</string>
        </dict>
    </dict>
    <key>%lld months sooner</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>На %#@months@ раньше</string>
        <key>months</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld месяц</string>
            <key>few</key><string>%lld месяца</string>
            <key>many</key><string>%lld месяцев</string>
            <key>other</key><string>%lld месяца</string>
        </dict>
    </dict>
    <key>%lld months sooner, %@ less interest</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>На %#@months@ раньше и на %@ меньше процентов</string>
        <key>months</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld месяц</string>
            <key>few</key><string>%lld месяца</string>
            <key>many</key><string>%lld месяцев</string>
            <key>other</key><string>%lld месяца</string>
        </dict>
    </dict>
    <key>%lld days left this week</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>До конца недели %#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld день</string>
            <key>few</key><string>%lld дня</string>
            <key>many</key><string>%lld дней</string>
            <key>other</key><string>%lld дня</string>
        </dict>
    </dict>
<key>%lld days</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>%#@n@</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld день</string>
<key>few</key><string>%lld дня</string>
<key>many</key><string>%lld дней</string>
<key>other</key><string>%lld дня</string>
</dict>
</dict>
<key>%lld days, %lld working</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>%1$#@n@, рабочих: %2$lld</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%1$lld день</string>
<key>few</key><string>%1$lld дня</string>
<key>many</key><string>%1$lld дней</string>
<key>other</key><string>%1$lld дня</string>
</dict>
</dict>
<key>%lld payments sooner</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>На %#@n@ раньше</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld платёж</string>
<key>few</key><string>%lld платежа</string>
<key>many</key><string>%lld платежей</string>
<key>other</key><string>%lld платежа</string>
</dict>
</dict>
<key>After %lld months without pay you'd still have about %@.</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>Через %1$#@n@ без зарплаты у вас останется около %2$@.</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%1$lld месяц</string>
<key>few</key><string>%1$lld месяца</string>
<key>many</key><string>%1$lld месяцев</string>
<key>other</key><string>%1$lld месяца</string>
</dict>
</dict>
<key>Safety cushion: %lld days without pay</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>Запас прочности: %#@n@ без зарплаты</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld день</string>
<key>few</key><string>%lld дня</string>
<key>many</key><string>%lld дней</string>
<key>other</key><string>%lld дня</string>
</dict>
</dict>
<key>Vacation in %@: %lld of 28 days</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>Отпуск в %1$@ г.: %2$#@n@ из 28</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%2$lld день</string>
<key>few</key><string>%2$lld дня</string>
<key>many</key><string>%2$lld дней</string>
<key>other</key><string>%2$lld дня</string>
</dict>
</dict>
<key>%@; less than planned %lld times of %lld.</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>%1$@; меньше плана %2$#@n@ из %3$lld.</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%2$lld раз</string>
<key>few</key><string>%2$lld раза</string>
<key>many</key><string>%2$lld раз</string>
<key>other</key><string>%2$lld раза</string>
</dict>
</dict>
</dict>
</plist>
