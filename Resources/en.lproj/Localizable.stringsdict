<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>%lld months sooner</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@months@ sooner</string>
        <key>months</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld month</string>
            <key>other</key><string>%lld months</string>
        </dict>
    </dict>
    <key>%lld months sooner, %@ less interest</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@months@ sooner, %@ less interest</string>
        <key>months</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld month</string>
            <key>other</key><string>%lld months</string>
        </dict>
    </dict>
<key>%lld days</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>%#@n@</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld day</string>
<key>other</key><string>%lld days</string>
</dict>
</dict>
<key>%lld days, %lld working</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>%1$#@n@, %2$lld working</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%1$lld day</string>
<key>other</key><string>%1$lld days</string>
</dict>
</dict>
<key>%lld payments sooner</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>%#@n@ sooner</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld payment</string>
<key>other</key><string>%lld payments</string>
</dict>
</dict>
<key>After %lld months without pay you'd still have about %@.</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>After %1$#@n@ without pay you'd still have about %2$@.</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%1$lld month</string>
<key>other</key><string>%1$lld months</string>
</dict>
</dict>
<key>Safety cushion: %lld days without pay</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>Safety cushion: %#@n@ without pay</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld day</string>
<key>other</key><string>%lld days</string>
</dict>
</dict>
<key>Vacation in %@: %lld of 28 days</key>
<dict>
<key>NSStringLocalizedFormatKey</key><string>Vacation in %1$@: %2$#@n@ of 28</string>
<key>n</key>
<dict>
<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
<key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%2$lld day</string>
<key>other</key><string>%2$lld days</string>
</dict>
</dict>
</dict>
</plist>
